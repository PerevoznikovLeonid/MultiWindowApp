<!-- CommonResources.axaml -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

  <!-- Размеры шрифтов -->
  <sys:Double x:Key="FontSize">14</sys:Double>
  <sys:Double x:Key="FontSizeTitle">25</sys:Double>
    
  <!-- Отступы -->
  <Thickness x:Key="MarginLabel">15 5 5 10</Thickness>
  <Thickness x:Key="MarginTextBox">5 5 15 10</Thickness>
  <Thickness x:Key="MarginTitle">20</Thickness>
    
  <!-- Размеры кнопок -->
  <sys:Double x:Key="ButtonWidth">100</sys:Double>
  <sys:Double x:Key="ButtonHeight">35</sys:Double>
  
  <Color x:Key="PrimaryColor">#2C3E50</Color>
  <Color x:Key="SecondaryColor">#3498DB</Color>
  <Color x:Key="BackgroundColor">#ECF0F1</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="TextColor">#2C3E50</Color>
  <Color x:Key="ButtonHoverColor">#2980B9</Color>
  <Color x:Key="DangerColor">#E74C3C</Color>
  <Color x:Key="WarningColor">#F39C12</Color>
  <Color x:Key="SuccessColor">#27AE60</Color>
  <Color x:Key="LightGrayColor">#F5F5F5</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
</ResourceDictionary>